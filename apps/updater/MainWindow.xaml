<Window x:Class="EchoUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echo Güncelleme"
        Height="260" Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern Custom ProgressBar Style -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1e293b" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6366f1" Offset="0.0" />
                                            <GradientStop Color="#a855f7" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Indigo Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366f1" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4f46e5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338ca" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Slate Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1e293b" />
            <Setter Property="Foreground" Value="#cbd5e1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#f8fafc" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0f172a" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748b" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e293b" />
                                <Setter Property="Foreground" Value="#f8fafc" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="#0f172a"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Echo Logo / Icon -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                        Background="#1e1b4b" BorderBrush="#4338ca" BorderThickness="1">
                    <Image Source="icon.png" Width="28" Height="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Title & Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                    <TextBlock Text="Echo Güncelleniyor..."
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#f8fafc" />
                    <TextBlock x:Name="StatusTextBlock"
                               Text="En son sürüm GitHub üzerinden indiriliyor..."
                               FontSize="13"
                               Foreground="#94a3b8"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        ToolTip="Kapat" />
            </Grid>

            <!-- Center Progress Area -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,0">
                <!-- Normal Progress View -->
                <StackPanel x:Name="ProgressPanel" Visibility="Visible">
                    <!-- Progress Bar -->
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Value="0"
                                 Maximum="100" />

                    <!-- Status Details -->
                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="DownloadDetailsTextBlock"
                                   Text="Bağlantı kuruluyor..."
                                   FontSize="12"
                                   Foreground="#64748b" />
                        <TextBlock x:Name="PercentTextBlock"
                                   Text="%0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#818cf8"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Error View -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <Border Background="#2a1215"
                            BorderBrush="#7f1d1d"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Güncelleme sırasında bir sorun oluştu"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#fca5a5" />
                            <TextBlock x:Name="ErrorDetailsTextBlock"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#f87171"
                                       TextWrapping="Wrap"
                                       MaxHeight="45"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Kapat"
                                Click="CloseButton_Click"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Yeniden Dene"
                                Click="RetryButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer / Info Text -->
            <TextBlock Grid.Row="2"
                       Text="Echo Ses ve Topluluk İletişim Platformu"
                       FontSize="11"
                       Foreground="#475569"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
