{
  "name": "@echo/desktop",
  "version": "0.1.63",
  "description": "Echo - Real-time Voice, Video and Chat",
  "author": "Echo Team",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:user2": "cross-env ECHO_PROFILE=user2 electron-vite dev",
    "build": "electron-vite build",
    "build:exe": "electron-vite build && electron-builder --win nsis",
    "build:linux": "electron-vite build && electron-builder --linux AppImage deb tar.gz",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@echo/shared": "workspace:*",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "build": {
    "appId": "com.echo.app",
    "productName": "Echo",
    "publish": {
      "provider": "github",
      "owner": "erdemyuksel4",
      "repo": "Echo"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "extraFiles": [
        {
          "from": "../updater/bin/Release/publish/EchoUpdater.exe",
          "to": "EchoUpdater.exe"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Network;Chat",
      "maintainer": "Echo Team <erdemyuksel.dev@gmail.com>",
      "synopsis": "Echo - P2P & Real-time Voice, Video and Chat Platform",
      "description": "Echo is a secure, decentralized real-time voice, video, screen share and messaging application."
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Echo",
      "uninstallDisplayName": "Echo",
      "runAfterFinish": true,
      "differentialPackage": true
    },
    "nsisWeb": {
      "differentialPackage": true
    }
  }
}
