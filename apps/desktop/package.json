{
  "name": "@echo/desktop",
  "version": "0.1.24",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:user2": "cross-env ECHO_PROFILE=user2 electron-vite dev",
    "build": "electron-vite build",
    "build:exe": "electron-vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@echo/shared": "workspace:*",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "build": {
    "appId": "com.echo.app",
    "productName": "Echo",
    "publish": {
      "provider": "github",
      "owner": "erdemyuksel4",
      "repo": "Echo"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../updater/bin/Release/publish/EchoUpdater.exe",
        "to": "EchoUpdater.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Echo",
      "uninstallDisplayName": "Echo",
      "runAfterFinish": true
    }
  }
}
